{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Trichr-o-matic: Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Scan Tool: Run (standalone)",
            "type": "debugpy",
            "request": "launch",
            "module": "trichrome.scan_tool",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
